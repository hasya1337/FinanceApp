<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- КНОПКИ -->

	<SolidColorBrush x:Key="ButtonColor"
					 Color="#FF9800"/>

	<SolidColorBrush x:Key="ButtonHoverColor"
					 Color="#FFB74D"/>

	<SolidColorBrush x:Key="ButtonPressedColor"
					 Color="#F57C00"/>

	<SolidColorBrush x:Key="TopButtonHover"
					 Color="#30FFFFFF"/>

	<SolidColorBrush x:Key="TopButtonPressed"
					 Color="#50FFFFFF"/>

    <!-- ОКНО -->
    
	<SolidColorBrush x:Key="WindowBackground"
					 Color="#1E1E1E"/>

	<SolidColorBrush x:Key="ControlBackground"
					 Color="#2D2D30"/>

	<SolidColorBrush x:Key="ForegroundColor"
					 Color="White"/>

</ResourceDictionary>
    