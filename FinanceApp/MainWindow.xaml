<Window x:Class="FinanceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"

        Background="Transparent"

        Title="Finance App"
        Height="850"
        Width="1100">

    <Window.Resources>

        <!-- ОСНОВНЫЕ КНОПКИ -->
        <Style x:Key="AnimatedButtonStyle"
        TargetType="Button">

            <Setter Property="Foreground"
            Value="White"/>

            <Setter Property="FontSize"
            Value="18"/>

            <Setter Property="FontWeight"
            Value="Bold"/>

            <Setter Property="Cursor"
            Value="Hand"/>

            <Setter Property="BorderThickness"
            Value="0"/>

            <Setter Property="FocusVisualStyle"
            Value="{x:Null}"/>

            <Setter Property="Background"
            Value="{DynamicResource ButtonColor}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border"
                        CornerRadius="12"
                        Padding="10"
                        Background="{TemplateBinding Background}">

                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- HOVER -->
                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter Property="Background"
                                Value="{DynamicResource ButtonHoverColor}"/>

                            </Trigger>

                            <!-- PRESSED -->
                            <Trigger Property="IsPressed"
                             Value="True">

                                <Setter Property="Background"
                                Value="{DynamicResource ButtonPressedColor}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- КНОПКИ В TITLE BAR -->
        <Style x:Key="TopBarButtonStyle"
       TargetType="Button">

    <Setter Property="Background"
            Value="Transparent"/>

    <Setter Property="Foreground"
            Value="{DynamicResource ForegroundColor}"/>

    <Setter Property="BorderThickness"
            Value="0"/>

    <Setter Property="Cursor"
            Value="Hand"/>

    <Setter Property="FocusVisualStyle"
            Value="{x:Null}"/>

    <Setter Property="Template">

        <Setter.Value>

            <ControlTemplate TargetType="Button">

                <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        Padding="5">

                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                </Border>

                <ControlTemplate.Triggers>

                    <!-- HOVER -->
                    <Trigger Property="IsMouseOver"
                             Value="True">

                        <Setter Property="Background"
                                Value="{DynamicResource TopButtonHover}"/>

                    </Trigger>

                    <!-- PRESSED -->
                    <Trigger Property="IsPressed"
                             Value="True">

                        <Setter Property="Background"
                                Value="{DynamicResource TopButtonPressed}"/>

                    </Trigger>

                </ControlTemplate.Triggers>

            </ControlTemplate>

        </Setter.Value>

    </Setter>

</Style>

        <!-- TEXTBOX -->
        <Style TargetType="TextBox"
               >

            <Setter Property="Background"
                    
                    Value="{DynamicResource ControlBackground}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundColor}"/>

            <Setter Property="BorderBrush"
                    Value="Gray"/>

            <Setter Property="CaretBrush"
                    Value="{DynamicResource ForegroundColor}"/>

            <Setter Property="Padding"
                    Value="5"/>

        </Style>

        <!-- TEXTBLOCK -->
        <Style TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundColor}"/>

        </Style>

        <!-- DATEPICKER -->
        <Style TargetType="DatePicker">

            <Setter Property="Background"
                    Value="{DynamicResource ControlBackground}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundColor}"/>

        </Style>

        <!-- DATEPICKER TEXTBOX -->
        <Style TargetType="{x:Type DatePickerTextBox}">

            <Setter Property="Background"
                    Value="{DynamicResource ControlBackground}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundColor}"/>

            <Setter Property="BorderBrush"
                    Value="Gray"/>

            <Setter Property="CaretBrush"
                    Value="{DynamicResource ForegroundColor}"/>

        </Style>

        <!-- DATAGRID -->
        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="{DynamicResource ControlBackground}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundColor}"/>

            <Setter Property="BorderBrush"
                    Value="Gray"/>

            <Setter Property="RowBackground"
                    Value="{DynamicResource ControlBackground}"/>

            <Setter Property="AlternatingRowBackground"
                    Value="{DynamicResource ControlBackground}"/>

            <Setter Property="GridLinesVisibility"
                    Value="All"/>

        </Style>

        <!-- HEADER -->
        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="{DynamicResource ControlBackground}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundColor}"/>

            <Setter Property="BorderBrush"
                    Value="Gray"/>

            <Setter Property="BorderThickness"
                    Value="0,0,1,1"/>

            <Setter Property="Padding"
                    Value="10,5"/>

        </Style>

        <!-- ROW -->
        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="{DynamicResource ControlBackground}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundColor}"/>

        </Style>

        <!-- CELL -->
        <Style TargetType="DataGridCell">

            <Setter Property="Background"
                    Value="{DynamicResource ControlBackground}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundColor}"/>

            <Setter Property="BorderBrush"
                    Value="Gray"/>

        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource WindowBackground}"
            BorderBrush="Gray"
            BorderThickness="2"
            CornerRadius="10">

        <Grid Margin="15">

            <Grid.RowDefinitions>

                <RowDefinition Height="80"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <!-- НАЗВАНИЕ -->
                <TextBlock x:Name="TitleTextBlock"
                           Text="Личное финансовое приложение"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>

                <!-- ЯЗЫК -->
                <Button x:Name="LanguageButton"
                        Grid.Column="1"
                        Width="55"
                        Height="35"
                        Margin="5"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        FontSize="18"
                        Content="EN"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="LanguageButton_Click"/>

                <!-- ТЕМА -->
                <Button x:Name="ThemeButton"
                        Grid.Column="2"
                        Width="55"
                        Height="45"
                        Margin="5"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Content="🔆"
                        Style="{StaticResource TopBarButtonStyle}"
                        Click="ThemeButton_Click"/>

                <!-- ЗАКРЫТЬ -->
                <Button Grid.Column="3"
                        Width="40"
                        Height="35"
                        Margin="5"
                        VerticalAlignment="Center"
                        Style="{StaticResource AnimatedButtonStyle}"
                        Click="CloseButton_Click">

                    <TextBlock Text="✕"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,-2,0,0"/>

                </Button>

            </Grid>

            <!-- ВВОД -->
            <StackPanel Grid.Row="1"
                        Margin="0,20,0,20">

                <TextBlock x:Name="CategoryLabel"
                           FontSize="18"/>

                <TextBox x:Name="CategoryTextBox"
                         Height="40"
                         Margin="0,5,0,15"/>

                <TextBlock x:Name="AmountLabel"
                           FontSize="18"/>

                <TextBox x:Name="AmountTextBox"
                         Height="40"
                         Margin="0,5,0,15"/>

                <TextBlock x:Name="DateLabel"
                           FontSize="18"/>

                <DatePicker x:Name="OperationDatePicker"
                            Height="40"
                            Margin="0,5,0,20"/>

                <StackPanel Orientation="Horizontal">

                    <Button x:Name="IncomeButton"
                            Width="220"
                            Height="50"
                            Margin="5"
                            Style="{StaticResource AnimatedButtonStyle}"
                            Click="IncomeButton_Click"/>

                    <Button x:Name="ExpenseButton"
                            Width="220"
                            Height="50"
                            Margin="5"
                            Style="{StaticResource AnimatedButtonStyle}"
                            Click="ExpenseButton_Click"/>

                </StackPanel>

            </StackPanel>

            <!-- ФИЛЬТР -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,0,0,20">

                <DatePicker x:Name="FromDatePicker"
                            Width="180"
                            Margin="5"/>

                <DatePicker x:Name="ToDatePicker"
                            Width="180"
                            Margin="5"/>

                <Button x:Name="FilterButton"
                        Width="220"
                        Height="40"
                        Margin="5"
                        Style="{StaticResource AnimatedButtonStyle}"
                        Click="FilterButton_Click"/>

            </StackPanel>

            <!-- ТАБЛИЦА -->
            <DataGrid x:Name="FinanceGrid"
                      Grid.Row="3"
                      Margin="0,10"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False">

                <DataGrid.Columns>

                    <DataGridTextColumn x:Name="TypeColumn"
                                        Binding="{Binding Type}"
                                        Width="*"/>

                    <DataGridTextColumn x:Name="CategoryColumn"
                                        Binding="{Binding Category}"
                                        Width="*"/>

                    <DataGridTextColumn x:Name="AmountColumn"
                                        Binding="{Binding Amount}"
                                        Width="*"/>

                    <DataGridTextColumn x:Name="DateColumn"
                                        Binding="{Binding Date}"
                                        Width="*"/>

                    <DataGridTemplateColumn x:Name ="Header" 
                                            Header="{Binding Action}"
                                            Width="120">
                        
                        <DataGridTemplateColumn.CellTemplate>
                            
                            <DataTemplate>
                                
                                <Button x:Name ="ButtonDelete"
                                        Content="🗑️"
                                        Click="DeleteButton_Click"
                                        Style="{StaticResource TopBarButtonStyle}"
                                        />
                                
                            </DataTemplate>
                            
                        </DataGridTemplateColumn.CellTemplate>
                        
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

            <!-- БАЛАНС -->
            <TextBlock x:Name="BalanceText"
                       Grid.Row="4"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="10"/>

        </Grid>

    </Border>

</Window>
    